# Supabase (선택) — 비워두면 로그인 없이 로컬 전용 모드로 동작합니다.
# 값 얻는 방법: docs/SUPABASE_SETUP.md 참고
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini 키는 여기에 넣지 않습니다.
# 빌드에 넣은 값(VITE_*)은 앱 파일에 글자 그대로 박혀서 누구나 볼 수 있습니다.
# 우리 키는 서버 함수에만 둡니다 — docs/SUPABASE_SETUP.md §5b

# 웹 푸시 (잠금 화면 알람) — npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
