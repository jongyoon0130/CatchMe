{
  "name": "futureme-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --open /goals.html",
    "dev:chat": "vite --open /index.html",
    "build": "tsc -b && vite build",
    "build:ios": "bun run build && bunx cap sync ios",
